SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ADMIN_PASSWORD=
RATE_LIMIT_SALT=

# Chat: gemini or shopaipro. Gemini remains the optional embedding provider.
CHAT_PROVIDER=shopaipro
SHOPAI_BASE_URL=https://shopaipro.tech/v1
LIBRARY_SHOPAI_API_KEY=
# Candidate from the free product page; verify against models allowed by your key.
SHOPAI_MODEL=nemotron-super

# none: keyword retrieval; gemini: optional vector embeddings
EMBEDDING_PROVIDER=none
